// Vaikuntham — PostgreSQL schema (Supabase)
// Money: always integer paise. Never float.
// Tenancy: every domain row carries hostelId where applicable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  WARDEN
  ACCOUNTANT
}

enum BedStatus {
  VACANT
  OCCUPIED
  BLOCKED
  MAINTENANCE
}

enum ResidentStatus {
  APPLICANT
  ACTIVE
  VACATED
}

enum AllotmentStatus {
  ACTIVE
  ENDED
}

model Hostel {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  clerkOrgId String?  @unique
  address    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  memberships Membership[]
  invites     MembershipInvite[]
  blocks      Block[]
  residents   Resident[]
  allotments  Allotment[]
  auditLogs   AuditLog[]
}

model Membership {
  id          String   @id @default(cuid())
  hostelId    String
  clerkUserId String
  role        Role
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hostel Hostel @relation(fields: [hostelId], references: [id], onDelete: Cascade)

  @@unique([hostelId, clerkUserId])
  @@index([clerkUserId])
}

model MembershipInvite {
  id          String    @id @default(cuid())
  hostelId    String
  email       String
  role        Role      @default(WARDEN)
  invitedById String
  acceptedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  hostel Hostel @relation(fields: [hostelId], references: [id], onDelete: Cascade)

  @@unique([hostelId, email])
  @@index([email])
}

model Block {
  id        String   @id @default(cuid())
  hostelId  String
  name      String
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hostel Hostel  @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  floors Floor[]

  @@unique([hostelId, name])
  @@index([hostelId])
}

model Floor {
  id        String   @id @default(cuid())
  blockId   String
  name      String
  level     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  block Block  @relation(fields: [blockId], references: [id], onDelete: Cascade)
  rooms Room[]

  @@unique([blockId, name])
  @@index([blockId])
}

model Room {
  id        String   @id @default(cuid())
  floorId   String
  number    String
  capacity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  floor Floor @relation(fields: [floorId], references: [id], onDelete: Cascade)
  beds  Bed[]

  @@unique([floorId, number])
  @@index([floorId])
}

model Bed {
  id        String    @id @default(cuid())
  roomId    String
  label     String
  status    BedStatus @default(VACANT)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  room       Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  allotments Allotment[]

  @@unique([roomId, label])
  @@index([roomId, status])
}

model Resident {
  id            String         @id @default(cuid())
  hostelId      String
  fullName      String
  phone         String?
  email         String?
  idType        String?
  idNumber      String?
  guardianName  String?
  guardianPhone String?
  status        ResidentStatus @default(APPLICANT)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  hostel     Hostel      @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  allotments Allotment[]

  @@index([hostelId, status])
  @@index([hostelId, fullName])
  @@index([hostelId, phone])
}

model Allotment {
  id         String          @id @default(cuid())
  hostelId   String
  residentId String
  bedId      String
  status     AllotmentStatus @default(ACTIVE)
  startAt    DateTime        @default(now())
  endAt      DateTime?
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  hostel   Hostel   @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  resident Resident @relation(fields: [residentId], references: [id], onDelete: Restrict)
  bed      Bed      @relation(fields: [bedId], references: [id], onDelete: Restrict)

  @@index([hostelId, status])
  @@index([residentId, status])
  @@index([bedId, status])
  // Partial unique indexes (one active allotment per bed/resident) — see migration SQL.
}

model AuditLog {
  id         String   @id @default(cuid())
  hostelId   String?
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  hostel Hostel? @relation(fields: [hostelId], references: [id], onDelete: SetNull)

  @@index([hostelId, createdAt])
  @@index([entityType, entityId])
}
