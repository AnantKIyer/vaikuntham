# Supabase Postgres — used by apps/api via packages/db (root .env only)
# Dashboard → Project Settings → Database → Connection string (URI)
# Special characters in the password must be URL-encoded (@ → %40). Always add ?sslmode=require
#
# Direct (IPv6-only on many networks — often fails locally with P1001):
#   postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
#
# Session pooler (recommended for local dev + Prisma migrate; port 5432):
#   postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
#
# Transaction pooler (port 6543) is PgBouncer transaction mode — Prisma migrate can fail.
# If you use 6543 for runtime, set DIRECT_URL to Session/Direct (5432) and wire prisma `directUrl`.
# With Session pooler (5432) as DATABASE_URL, DIRECT_URL is not required.
#
# Fast local dev (~10–50ms loads): npm run db:local:setup, then swap DATABASE_URL to:
#   postgresql://postgres:dev@localhost:5433/vaikuntham
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require"
# DIRECT_URL=  # only when DATABASE_URL is Transaction pooler :6543

# API (NestJS)
PORT=3001
WEB_ORIGIN="http://localhost:3000"
# Dev auth bypass (never in production). API also requires localhost peer or
# header x-auth-dev-bypass: true when AUTH_DEV_BYPASS=true (CB-160).
AUTH_DEV_BYPASS=false

# One-shot ops token for POST /v1/hostels and PATCH /v1/hostels/:id/link-org (CB-151).
# Generate a long random string; never commit the real value. Required outside AUTH_DEV_BYPASS for provisioning.
# HOSTEL_BOOTSTRAP_TOKEN=

# Web (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:3001"
API_URL="http://localhost:3001"

# Local UI without Clerk — set BOTH to true (never in production). Web sends x-auth-dev-bypass.
NEXT_PUBLIC_AUTH_DEV_BYPASS=false

# Clerk — uncomment when you have keys from https://dashboard.clerk.com → API Keys
# Then set AUTH_DEV_BYPASS / NEXT_PUBLIC_AUTH_DEV_BYPASS to false and restart both apps.
# Link each Hostel.clerkOrgId to the Clerk organization id (org_...).
# Additional staff: POST /v1/memberships/invites (admin) — no auto-join to demo hostel.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
