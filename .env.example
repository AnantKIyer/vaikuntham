# Neon Postgres (cloud-first)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Local UI without Clerk — set BOTH to true (never in production).
# AUTH_DEV_BYPASS alone is not enough; the browser needs NEXT_PUBLIC_AUTH_DEV_BYPASS.
AUTH_DEV_BYPASS=true
NEXT_PUBLIC_AUTH_DEV_BYPASS=true

# Clerk — uncomment when you have keys from https://dashboard.clerk.com → API Keys
# Then set both AUTH_* bypass flags to false and restart.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
